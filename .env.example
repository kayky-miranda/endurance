# Banco Postgres. Cole a connection string do seu provedor (Neon/Supabase/etc.).
# Use a URL com pooling para serverless (ex.: ...-pooler... / pgbouncer=true).
# Depois rode `npm run db:push` para criar as tabelas.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Segredo para assinar os cookies de sessão (JWT). Gere um valor aleatório:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# Provedor de IA do onboarding. Configure UMA das chaves abaixo (Gemini tem
# prioridade). Sem nenhuma, o onboarding roda em modo demonstração
# (classificador por palavras-chave).

# Google Gemini — tier GRATUITO (sem cartão): https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# (opcional) trocar o modelo do Gemini; padrão: gemini-2.0-flash
# GEMINI_MODEL="gemini-2.0-flash"

# Claude (Anthropic) — alternativa paga: https://console.anthropic.com
ANTHROPIC_API_KEY=""

# -----------------------------------------------------------------------------
# EMISSÃO FISCAL REAL — Focus NFe (NFC-e modelo 65)
# -----------------------------------------------------------------------------
# Por padrão a emissão é SIMULADA (protótipo). Para emitir de verdade, na tela
# Fiscal de cada empresa escolha "Real · Focus NFe" e preencha o NCM padrão; o
# certificado A1 e o CNPJ ficam cadastrados no painel do Focus NFe.
#
# Token de HOMOLOGAÇÃO (sandbox — notas SEM valor fiscal). Comece sempre por aqui:
#   https://app.focusnfe.com.br  → Configurações → Tokens
FOCUS_NFE_TOKEN_HOMOLOGACAO=""
# Token de PRODUÇÃO (notas COM valor fiscal). Deixe vazio até validar tudo.
FOCUS_NFE_TOKEN_PRODUCAO=""
# Trava de segurança: a emissão em PRODUÇÃO só é liberada com isto = "true"
# (além de ambiente=1 na empresa e do token de produção acima). Mantenha
# desligado enquanto estiver testando.
# FOCUS_NFE_ALLOW_PRODUCTION="true"

# -----------------------------------------------------------------------------
# COBRANÇA PIX — Mercado Pago
# -----------------------------------------------------------------------------
# Por padrão a cobrança é SIMULADA (BR Code gerado da chave PIX da empresa, na
# tela Notificações → Integrações). Para cobrar de verdade, escolha "Mercado
# Pago" na config da empresa e preencha o token abaixo.
# Token de TESTE tem prefixo "TEST-" (sandbox); qualquer outro é produção.
MERCADO_PAGO_ACCESS_TOKEN=""
# Segredo para validar a assinatura do webhook (x-signature). Cadastre no painel
# do Mercado Pago em Notificações → Webhooks → "Sua chave secreta". Sem isso, em
# produção o webhook é REJEITADO com 401.
MERCADO_PAGO_WEBHOOK_SECRET=""
# Trava de segurança: cobrança PIX em PRODUÇÃO só é liberada com isto = "true"
# (token de teste TEST-… funciona sem a flag). Mantenha desligado ao testar.
# PIX_ALLOW_PRODUCTION="true"
# (opcional) URL pública do app, para o webhook do PSP em /api/pix/webhook.
# APP_URL="https://seu-dominio.com"

# -----------------------------------------------------------------------------
# WHATSAPP BUSINESS — Meta Cloud API
# -----------------------------------------------------------------------------
# Por padrão o envio é SIMULADO (só registra a mensagem). Para enviar de verdade,
# escolha "Meta Cloud API" na config, preencha o Phone Number ID na empresa e o
# token abaixo, e ligue a flag.
WHATSAPP_TOKEN=""
# Token de verificação do webhook (/api/whatsapp/webhook) — defina o mesmo valor
# no painel da Meta ao assinar o webhook.
WHATSAPP_VERIFY_TOKEN=""
# App Secret do Facebook App para validar a assinatura x-hub-signature-256 dos
# eventos do WhatsApp. Encontre em developers.facebook.com → Seu App →
# Configurações → Básico → Chave secreta do App.
META_APP_SECRET=""

# -----------------------------------------------------------------------------
# E-MAIL TRANSACIONAL — Resend
# -----------------------------------------------------------------------------
# Usado para verificação de e-mail no signup, recuperação de senha e convites
# de equipe. Sem RESEND_API_KEY o envio entra em modo STUB (loga no console).
# Crie uma chave em https://resend.com/api-keys (free tier: 100 e-mails/dia).
RESEND_API_KEY=""
# Endereço remetente. O domínio precisa estar verificado no Resend antes de
# enviar pra usuários reais. Padrão: noreply@endurance.app
# EMAIL_FROM="ENDURANCE <noreply@endurance.app>"

# -----------------------------------------------------------------------------
# OBSERVABILIDADE — Sentry
# -----------------------------------------------------------------------------
# Sem SENTRY_DSN o SDK fica inerte (não envia nada). Pegue o DSN em
# sentry.io → Settings → Projects → [seu projeto] → Client Keys.
SENTRY_DSN=""
# Mesma chave que o servidor — exposta no client; é seguro segundo o Sentry.
# NEXT_PUBLIC_SENTRY_DSN=""
# Org e projeto para upload de source maps no build (apenas se SENTRY_DSN
# também estiver definido). Opcionais.
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# Auth token com escopo `project:releases` para o plugin do build. Opcional.
# SENTRY_AUTH_TOKEN=""
# Identifica o ambiente nos eventos (production | staging | development).
# SENTRY_ENV="production"

# -----------------------------------------------------------------------------
# CRON JOBS
# -----------------------------------------------------------------------------
# Vercel Cron envia "Authorization: Bearer ${CRON_SECRET}" em cada disparo.
# Sem isso, em produção os endpoints /api/cron/* sao bloqueados (em dev é só
# warning). Gere um valor aleatório:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""
# Trava de segurança: o envio real só acontece com isto = "true".
# WHATSAPP_ALLOW_SEND="true"

# RATE LIMIT DISTRIBUÍDO — Upstash Redis (REST)
# Sem essas variáveis, o rate limit roda em memória (por instância). Em
# produção serverless (Vercel), configure as duas para um contador GLOBAL.
# Crie um banco grátis em https://upstash.com (copie a REST URL e o token).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# STORAGE DE OBJETOS — S3/R2 (imagens, XML fiscal, logos, carrosséis)
# Sem essas variáveis, grava em public/ (efêmero em serverless — só dev).
# Em produção use Cloudflare R2 (barato) ou AWS S3. Endpoint do R2:
#   https://<account_id>.r2.cloudflarestorage.com  (região = "auto")
STORAGE_S3_ENDPOINT=""
STORAGE_S3_REGION="auto"
STORAGE_S3_BUCKET=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
# URL pública do bucket/CDN (domínio público do R2 ou CloudFront):
STORAGE_PUBLIC_BASE_URL=""

# COBRANÇA RECORRENTE — Asaas (assinatura PIX/boleto/cartão)
# Sem ASAAS_API_KEY, a cobrança roda em modo "manual" (auto-gerido, protótipo).
# Crie a chave no painel Asaas (sandbox: https://sandbox.asaas.com).
ASAAS_API_KEY=""
ASAAS_ENV="sandbox"           # ou "production"
# Token que você define ao cadastrar o webhook no Asaas (header asaas-access-token):
ASAAS_WEBHOOK_TOKEN=""
