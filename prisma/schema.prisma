// ENDURANCE — banco do protótipo.
// Multi-tenant por schema único: cada negócio é uma Organization e os módulos
// ativados ficam em OrgModule (o "registry de módulos" persistido).
// Postgres (produção/Vercel). Em dev local, aponte DATABASE_URL para o mesmo
// Postgres hospedado (não há mais SQLite).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String   @id @default(cuid())
  slug       String   @unique
  name       String
  niche      String
  nicheLabel String
  city       String   @default("")
  state      String   @default("")
  country    String   @default("")
  segment    String   @default("")
  createdAt  DateTime @default(now())

  modules          OrgModule[]
  users            User[]
  products         Product[]
  sales            Sale[]
  customers        Customer[]
  fiscalConfig     FiscalConfig?
  fiscalDocs       FiscalDocument[]
  cashSessions     CashSession[]
  finEntries       FinancialEntry[]
  suppliers        Supplier[]
  purchases        PurchaseOrder[]
  requisitions     PurchaseRequisition[]
  quotations       Quotation[]
  receipts         Receipt[]
  stockMovements   StockMovement[]
  stockCounts      StockCount[]
  productSuppliers ProductSupplier[]
  costCenters      CostCenter[]
  categories       Category[]
  importedInvoices ImportedInvoice[]
  activityLogs     ActivityLog[]
  aiUsage          AiUsage[]
  subscription     Subscription?
  invoices         Invoice[]
  pixCharges       PixCharge[]
  pixConfig        PixConfig?
  whatsappConfig   WhatsAppConfig?
  whatsappMessages WhatsAppMessage[]
  brandKit         BrandKit?
  campaigns        Campaign[]
  creditLedger     CreditLedger[]
  marketingSub     MarketingSubscription?
  invites          Invite[]
  themeSettings    ThemeSettings?
  apiKeys          ApiKey[]
  locations        Location[]
  productStocks    ProductStock[]
  receiptSettings  ReceiptSettings?
  appointments     Appointment[]
  clinicalNotes    ClinicalNote[]
  patientMetrics   PatientMetric[]
}

// Configuração do cupom/recibo impresso (um por organização). O logo reaproveita
// o de ThemeSettings; aqui ficam formato do papel, rodapé e o que exibir.
model ReceiptSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  paperSize      String   @default("80mm") // 80mm (bobina) | a4
  showLogo       Boolean  @default(true)
  showDocument   Boolean  @default(true)  // CNPJ/telefone no cabeçalho
  headerNote     String   @default("")    // linha extra no topo (ex.: endereço)
  footer         String   @default("Obrigado pela preferência!")
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Local de estoque: matriz, filial, depósito ou loja. Toda organização tem ao
// menos um (isDefault) — criado no onboarding e no backfill das contas antigas.
model Location {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String   @default("") // apelido curto (ex.: "MTZ", "FIL01")
  isDefault      Boolean  @default(false)
  active         Boolean  @default(true)
  address        String   @default("")
  city           String   @default("")
  state          String   @default("")
  createdAt      DateTime @default(now())

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  stocks       ProductStock[]
  movements    StockMovement[]
  users        User[]
  sales        Sale[]
  counts       StockCount[]

  @@index([organizationId, active])
}

// Saldo de um produto EM UM LOCAL. A soma dos locais é mantida em
// Product.stock (total consolidado) pelo razão — ver applyStockMovement.
model ProductStock {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  locationId     String
  qty            Int      @default(0)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  location     Location     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([productId, locationId])
  @@index([organizationId, locationId])
}

// Chave da API pública (/api/v1). O token completo (edk_…) é exibido UMA vez
// na criação; aqui fica só o hash SHA-256 + um prefixo para identificação.
model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  prefix         String // primeiros caracteres do token (exibição na lista)
  keyHash        String    @unique // sha256(token)
  createdById    String?
  createdByName  String    @default("")
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// White-label: cada empresa pode customizar a paleta do app. Todos os campos
// guardam HEX no formato #RRGGBB ou null (= usa o default do preset). O front
// resolve null → fallback. presetId é só "memória" do botão clicado.
model ThemeSettings {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  presetId        String   @default("default") // azul_corporativo | verde_empresarial | etc
  primaryColor    String? // botões, links, destaque
  secondaryColor  String? // acento secundário
  accentColor     String? // hover, ênfase pontual
  buttonTextColor String? // texto sobre primary (auto contraste; manual aqui)
  sidebarBg       String? // fundo da sidebar (modo claro)
  sidebarBgDark   String? // fundo da sidebar (modo escuro)
  textColor       String? // texto principal (modo claro)
  cardBg          String? // fundo de cards (modo claro)
  defaultDarkMode Boolean  @default(false) // tema escuro como padrão da org
  // Logo da empresa como data URL (base64) — sem precisar de Blob externo no
  // MVP. Limite de ~200KB no upload pra evitar inchar o banco. Em produção
  // (>100 orgs) trocar por Vercel Blob/R2 e guardar só a URL.
  logoDataUrl     String? @db.Text
  logoMime        String? // image/png | image/svg+xml | image/jpeg
  updatedAt       DateTime @updatedAt
  updatedById     String?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Assinatura SaaS do espaço (uma por organização). No protótipo a cobrança é
// auto-gerida (sem provedor de pagamento externo): a troca de plano é imediata
// e gera uma fatura interna. O modelo segue o vocabulário de provedores reais
// (status trialing/active/past_due/canceled, cancelamento ao fim do ciclo) para
// que um Stripe/Iugu possa ser plugado depois sem reescrever as telas.
model Subscription {
  id                 String    @id @default(cuid())
  organizationId     String    @unique
  plan               String    @default("starter") // starter | professional | business | enterprise
  status             String    @default("trialing") // trialing | active | past_due | canceled
  seats              Int       @default(2) // limite de usuários do plano
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean   @default(false)
  trialEndsAt        DateTime?
  // Referências do gateway de cobrança recorrente (Asaas). Null no modo manual.
  asaasCustomerId     String?
  asaasSubscriptionId String?
  // Plano aguardando confirmação de pagamento no gateway. O checkout grava só
  // a INTENÇÃO aqui; plano/status reais só mudam quando o webhook confirma o
  // pagamento (PAYMENT_CONFIRMED/RECEIVED). Limpo ao aplicar ou desistir.
  pendingPlan         String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
}

// Fatura interna gerada a cada cobrança/troca de plano paga. Guarda o valor
// congelado do plano e o período coberto — base do histórico de cobrança.
model Invoice {
  id             String    @id @default(cuid())
  organizationId String
  subscriptionId String
  number         String // número humano sequencial (ex.: 2026-0001)
  plan           String
  amount         Decimal   @db.Decimal(12, 2)
  status         String    @default("paga") // paga | pendente | falhou
  periodStart    DateTime
  periodEnd      DateTime
  issuedAt       DateTime  @default(now())
  paidAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([organizationId, issuedAt])
}

// Telemetria de IA por organização: cada chamada a um provedor (ou queda na
// heurística offline) vira um registro com tokens, latência e resultado.
// organizationId é nulo nas chamadas pré-tenant (onboarding, antes do signup).
model AiUsage {
  id             String   @id @default(cuid())
  organizationId String?
  feature        String // assistant | onboarding | sales_insights | stock_advice | crm_campaigns | pricing_advice
  provider       String // gemini | anthropic | offline
  model          String   @default("")
  inputTokens    Int      @default(0)
  outputTokens   Int      @default(0)
  latencyMs      Int      @default(0)
  ok             Boolean  @default(true)
  fallback       Boolean  @default(false) // resolveu pela heurística offline
  error          String   @default("")
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

// Nota fiscal importada por XML (NF-e modelo 55 / NFC-e modelo 65). Registro
// para migração/auditoria — guarda o cabeçalho parseado + o XML bruto.
// Idempotente por chave de acesso dentro da organização.
model ImportedInvoice {
  id             String   @id @default(cuid())
  organizationId String
  chave          String
  modelo         String   @default("55")
  serie          Int      @default(0)
  numero         Int      @default(0)
  emitCnpj       String   @default("")
  emitNome       String   @default("")
  total          Decimal  @default(0) @db.Decimal(12, 2)
  itemsCount     Int      @default(0)
  dhEmi          DateTime @default(now())
  xml            String
  // Lançamentos gerados a partir da nota (entrada de estoque / conta a pagar).
  // Ficam no header porque a importação é idempotente por chave: só a primeira
  // importação de uma chave lança estoque/financeiro.
  appliedStock   Boolean  @default(false)
  appliedPayable Boolean  @default(false)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, chave])
  @@index([organizationId])
}

// Registro de categorias (alimentado pela importação em massa; reutilizável em
// filtros/cadastros). Único por nome dentro da organização.
model Category {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Fornecedor do negócio (compras / reposição de estoque). Cadastro completo:
// identidade fiscal, endereço, condições comerciais e avaliação (usada no
// ranking de cotações). Contatos adicionais em SupplierContact.
model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  // Identidade — `name` é o nome de exibição (fantasia ou razão social).
  name           String
  razaoSocial    String   @default("")
  nomeFantasia   String   @default("")
  cnpj           String   @default("")
  ie             String   @default("") // inscrição estadual
  // Endereço
  address        String   @default("")
  city           String   @default("")
  state          String   @default("")
  zip            String   @default("")
  country        String   @default("Brasil")
  // Contato principal (contatos adicionais ficam em SupplierContact)
  phone          String   @default("")
  email          String   @default("")
  // Condições comerciais
  paymentTermDays Int     @default(0) // prazo de pagamento (dias)
  leadTimeDays    Int     @default(0) // prazo médio de entrega (dias)
  creditLimit     Decimal @default(0) @db.Decimal(12, 2)
  rating          Float   @default(0) // avaliação 0..5 (ranking de cotação)
  status          String  @default("ativo") // ativo | inativo
  note            String  @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  // Exclusão LÓGICA: pedidos e cotações antigos preservam o fornecedor.
  // Filtrado globalmente pela extensão do Prisma em lib/db.ts.
  deletedAt       DateTime?

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orders        PurchaseOrder[]
  contacts      SupplierContact[]
  productLinks  ProductSupplier[]
  quotationBids QuotationSupplier[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, status])
}

// Contato adicional de um fornecedor (um fornecedor tem vários contatos).
model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  name       String
  role       String   @default("") // cargo/função do contato
  phone      String   @default("")
  mobile     String   @default("")
  email      String   @default("")
  createdAt  DateTime @default(now())

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

// Vínculo Produto ⇄ Fornecedor (N:N). Um produto pode ter vários fornecedores e
// um fornecedor fornece vários produtos. Guarda o código/custo do fornecedor.
model ProductSupplier {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  supplierId     String
  supplierSku    String   @default("") // código do produto no fornecedor
  unitCost       Decimal  @default(0) @db.Decimal(12, 2)
  leadTimeDays   Int      @default(0)
  lastPurchaseAt DateTime?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([productId, supplierId])
  @@index([organizationId])
  @@index([supplierId])
}

// Centro de custo (para classificar solicitações de compra e despesas).
model CostCenter {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String   @default("")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requisitions PurchaseRequisition[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Pedido de compra. Ao ser RECEBIDO: dá entrada no estoque dos itens e gera uma
// conta a pagar no financeiro (fechando o ciclo reposição → compra → estoque → $).
model PurchaseOrder {
  id             String    @id @default(cuid())
  organizationId String
  supplierId     String
  requisitionId  String? // origem (quando gerado de uma solicitação)
  quotationId    String? // origem (quando gerado da cotação vencedora)
  status         String    @default("aberto") // aberto | enviado | confirmado | parcial | recebido | cancelado
  total          Decimal   @default(0) @db.Decimal(12, 2)
  paymentTerm    String    @default("") // condição de pagamento (texto livre)
  note           String    @default("")
  createdAt      DateTime  @default(now())
  expectedDate   DateTime? // previsão de entrega
  confirmedAt    DateTime? // confirmação do fornecedor
  receivedAt     DateTime?
  sentAt         DateTime? // quando o pedido foi enviado ao fornecedor
  sentVia        String    @default("") // whatsapp | email | manual

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier             @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  requisition  PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  quotation    Quotation?           @relation(fields: [quotationId], references: [id], onDelete: SetNull)
  items        PurchaseOrderItem[]
  receipts     Receipt[]

  @@index([organizationId])
  @@index([organizationId, status])
}

model PurchaseOrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String?
  name        String
  quantity    Int
  receivedQty Int     @default(0) // quantidade já recebida (recebimento parcial)
  unitCost    Decimal @db.Decimal(12, 2)

  order       PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receiptItems ReceiptItem[]

  @@index([orderId])
}

// Sessão de caixa (turno do PDV). Abre com um fundo de troco e fecha com a
// conferência do dinheiro contado x esperado. Vendas feitas com o caixa aberto
// ficam vinculadas a ele para compor o esperado em dinheiro.
model CashSession {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  status         String    @default("aberto") // aberto | fechado
  openingAmount  Decimal   @default(0) @db.Decimal(12, 2)
  countedAmount  Decimal?  @db.Decimal(12, 2) // informado no fechamento
  expectedAmount Decimal?  @db.Decimal(12, 2) // congelado no fechamento
  difference     Decimal?  @db.Decimal(12, 2) // contado - esperado
  note           String    @default("")
  openedAt       DateTime  @default(now())
  closedAt       DateTime?

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  movements    CashMovement[]
  sales        Sale[]

  @@index([organizationId])
}

// Movimento de caixa: suprimento (reforço) ou sangria (retirada).
model CashMovement {
  id        String   @id @default(cuid())
  sessionId String
  type      String // suprimento | sangria
  amount    Decimal  @db.Decimal(12, 2)
  reason    String   @default("")
  userId    String?
  createdAt DateTime @default(now())

  session CashSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

// Lançamento financeiro: conta a receber ou a pagar. Os recebíveis são gerados
// automaticamente a partir das formas de pagamento das vendas do PDV.
model FinancialEntry {
  id             String    @id @default(cuid())
  organizationId String
  kind           String // receber | pagar
  description    String
  category       String    @default("")
  amount         Decimal   @db.Decimal(12, 2)
  status         String    @default("pendente") // pendente | pago
  method         String    @default("")
  saleId         String?
  dueDate        DateTime
  paidAt         DateTime?
  // Conciliação: quando o recebível foi batido contra a cobrança/extrato externo.
  reconciledAt   DateTime?
  externalRef    String    @default("") // referência externa (txid PIX, id de extrato)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, kind])
  @@index([saleId])
}

// Configuração fiscal da empresa (emitente da NFC-e, modelo 65). Uma por org.
// crt: regime tributário (1=Simples Nacional, 3=Regime Normal).
// ambiente: 1=Produção, 2=Homologação. csc/cscId: credencial do QR Code.
model FiscalConfig {
  id             String   @id @default(cuid())
  organizationId String   @unique
  cnpj           String   @default("")
  razaoSocial    String   @default("")
  nomeFantasia   String   @default("")
  ie             String   @default("")
  crt            String   @default("1")
  uf             String   @default("SP")
  cMun           String   @default("")
  municipio      String   @default("")
  serie          Int      @default(1)
  proxNumero     Int      @default(1)
  ambiente       String   @default("2")
  cscId          String   @default("000001")
  csc            String   @default("")
  // Emissão real: "" = simulada (protótipo) | "focusnfe" = provedor homologado.
  provider       String   @default("")
  // NCM padrão dos itens (8 díg.) quando o produto não tem NCM próprio. A SEFAZ
  // valida o NCM, então a emissão real exige ao menos este default por empresa.
  defaultNcm     String   @default("")
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Documento fiscal emitido (NFC-e, modelo 65) vinculado a uma venda do PDV.
// No protótipo a autorização SEFAZ é simulada (protocolo/data), mas a chave de
// acesso, o dígito verificador, o QR Code e o XML seguem o layout oficial 4.00.
model FiscalDocument {
  id              String    @id @default(cuid())
  organizationId  String
  saleId          String    @unique
  modelo          String    @default("65")
  serie           Int
  numero          Int
  chave           String    @unique
  status          String    @default("autorizada") // autorizada | cancelada
  ambiente        String
  protocolo       String    @default("")
  qrCode          String    @default("")
  xml             String    @default("")
  valorTotal      Decimal   @db.Decimal(12, 2)
  motivoCancel    String    @default("")
  // Rastreabilidade do provedor de emissão real (vazio quando simulado).
  provider        String    @default("") // "" | "focusnfe"
  providerRef     String    @default("") // referência idempotente enviada ao provedor
  danfeUrl        String    @default("") // URL do DANFE/cupom no provedor
  dataEmissao     DateTime  @default(now())
  dataAutorizacao DateTime?
  dataCancel      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

// Cliente do negócio (CRM). Pode ser cadastrado na hora da venda no PDV.
model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String   @default("")
  email          String   @default("")
  document       String   @default("")
  createdAt      DateTime @default(now())
  // Exclusão LÓGICA: preserva o histórico (vendas, fiado). Filtrado
  // globalmente pela extensão do Prisma em lib/db.ts.
  deletedAt      DateTime?

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sales            Sale[]
  whatsAppMessages WhatsAppMessage[]
  appointments     Appointment[]
  clinicalNotes    ClinicalNote[]
  metrics          PatientMetric[]

  @@index([organizationId, deletedAt])
}

// Evolução do paciente: medições numéricas ao longo do tempo (peso, medidas,
// escalas). Serve nutrição (antropometria), psicologia (escalas) e clínica.
// Cada ponto é (metric, value, unit) em measuredAt — modelo genérico para
// servir qualquer indicador sem novo schema por nicho.
model PatientMetric {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String
  metric         String // chave: "peso", "gordura", "abdomen", "escala_humor"…
  label          String   @default("") // rótulo exibido (snapshot do preset/livre)
  value          Decimal  @db.Decimal(12, 3)
  unit           String   @default("")
  measuredAt     DateTime
  notes          String   @default("")
  createdById    String?
  createdByName  String   @default("")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId, metric, measuredAt])
  @@index([customerId, measuredAt])
}

// Prontuário clínico: anotações confidenciais do paciente (evolução, condutas,
// queixas). Serve nutrição, psicologia e clínica. É SEMPRE sobre um Customer
// (paciente) e pode citar o atendimento de origem. Exclusão LÓGICA (deletedAt)
// por retenção clínica/legal — nada é apagado de fato.
model ClinicalNote {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String // paciente (Customer) — obrigatório
  appointmentId  String? // atendimento de origem (opcional)
  authorId       String?
  authorName     String   @default("")
  title          String   @default("")
  content        String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  editedAt       DateTime? // marcado na 1ª edição — flag confiável de "editada"
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerId, deletedAt])
  @@index([customerId, createdAt])
}

// Agenda de atendimentos (consultas, sessões, serviços). Serve os ramos de
// serviço — nutrição, psicologia, clínica, salão. O "paciente/cliente" é o
// Customer; o profissional é um User (opcional). Snapshots de nome preservam
// o histórico mesmo se o cadastro mudar.
model Appointment {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String? // paciente/cliente (Customer); null = avulso
  customerName   String   @default("") // snapshot do nome exibido
  professionalId String? // User que atende
  professional   String   @default("") // snapshot do nome do profissional
  service        String   @default("") // tipo de atendimento
  startsAt       DateTime
  durationMin    Int      @default(30)
  status         String   @default("agendado") // agendado | confirmado | atendido | faltou | cancelado
  price          Decimal  @default(0) @db.Decimal(12, 2)
  notes          String   @default("")
  createdById    String?
  createdByName  String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@index([organizationId, startsAt])
  @@index([organizationId, status])
  @@index([customerId])
}

// Produto do catálogo de um negócio (módulo Cadastro de produtos / Estoque).
// Sempre escopado por organizationId — isolamento multi-tenant.
model Product {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  sku            String   @default("")
  barcode        String   @default("")
  category       String   @default("")
  price          Decimal  @default(0) @db.Decimal(12, 2)
  cost           Decimal  @default(0) @db.Decimal(12, 2)
  stock          Int      @default(0)
  unit           String   @default("un") // unidade (un, cx, kg, l...)
  ncm            String   @default("") // NCM fiscal do produto (8 díg.); vazio = usa o defaultNcm da empresa
  minStock       Int      @default(0) // estoque mínimo (ponto de alerta/reposição)
  createdAt      DateTime @default(now())
  // Exclusão LÓGICA: vendas/movimentações antigas continuam apontando para o
  // produto. Filtrado globalmente pela extensão do Prisma em lib/db.ts.
  deletedAt      DateTime?

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierLinks  ProductSupplier[]
  stockMovements StockMovement[]
  // Saldo por local; `stock` acima é o TOTAL consolidado (soma destes).
  locationStocks ProductStock[]

  @@index([organizationId, deletedAt])
  @@index([organizationId, barcode])
}

// Venda registrada no PDV. Baixa o estoque dos produtos no fechamento.
model Sale {
  id             String   @id @default(cuid())
  organizationId String
  customerId     String?
  userId         String?
  cashSessionId  String?
  token          String   @unique
  subtotal       Decimal  @default(0) @db.Decimal(12, 2)
  discount       Decimal  @default(0) @db.Decimal(12, 2)
  total          Decimal  @db.Decimal(12, 2)
  change         Decimal  @default(0) @db.Decimal(12, 2) // troco devolvido em dinheiro
  itemsCount     Int
  createdAt      DateTime @default(now())

  locationId   String? // local (loja) onde a venda foi feita

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  seller       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  cashSession  CashSession?    @relation(fields: [cashSessionId], references: [id], onDelete: SetNull)
  location     Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items        SaleItem[]
  payments     SalePayment[]
  fiscalDoc    FiscalDocument?
  pixCharge    PixCharge?

  @@index([organizationId])
  @@index([customerId])
  @@index([organizationId, locationId])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String?
  name      String
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}

// Pagamento de uma venda (permite split: várias formas na mesma venda).
model SalePayment {
  id     String  @id @default(cuid())
  saleId String
  method String // dinheiro | credito | debito | pix
  amount Decimal @db.Decimal(12, 2)

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
}

// Usuário de uma organização. role: OWNER | ADMIN | MEMBER (string — SQLite não
// suporta enum no Prisma). email é único global (login por e-mail + senha).
// O RBAC granular fica em `permissions` (ids do catálogo lib/endurance/permissions.ts);
// `profile` guarda o perfil pré-configurado escolhido (ou "" se personalizado).
// `status` controla bloqueio (active | blocked). `lastLoginAt` registra o último acesso.
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  emailVerifiedAt DateTime? // null = e-mail ainda não confirmado
  passwordHash    String
  name            String
  role            String    @default("MEMBER")
  phone           String    @default("")
  jobTitle        String    @default("") // cargo
  profile         String    @default("") // id do perfil pré-configurado
  permissions     String[]  @default([]) // ids de permissão (RBAC granular)
  status          String    @default("active") // active | blocked
  lastLoginAt     DateTime?
  // 2FA TOTP (RFC 6238). totpSecret é o segredo base32 usado pra gerar
  // os códigos. Em produção, idealmente criptografado por uma chave do app.
  // No MVP fica em texto — o controle de risco é o bcrypt da senha (mesmo
  // que o segredo vaze, o atacante ainda precisa da senha).
  totpSecret      String?
  totpEnabledAt   DateTime?
  // Backup codes do 2FA: 8 códigos single-use guardados como SHA-256 do
  // valor plain. Quando usuário usa um, removemos do array.
  totpBackupCodes String[]  @default([])
  organizationId  String
  // Local (loja/depósito) onde a pessoa opera: PDV e conferência usam este
  // saldo. Null = usa o local padrão da organização.
  locationId      String?
  createdAt       DateTime  @default(now())

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location            Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  sales               Sale[]
  whatsappMessages    WhatsAppMessage[]
  passwordResetTokens PasswordResetToken[]
  emailVerifyTokens   EmailVerifyToken[]

  @@index([organizationId])
}

// Tokens de recuperação de senha. Single-use, com expiração curta (1h).
// Guardamos só o HASH do token — o valor original nunca é persistido. Quando
// o usuário clica no link, recomputamos o hash e comparamos.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // SHA-256 hex do token plain
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Convite de equipe via link mágico. O OWNER/ADMIN cria com email + papel; o
// destinatário recebe um link e define o nome/senha em /convite/[token]. O
// usuário só é criado no aceite — antes disso, e-mail vazado não cria conta.
model Invite {
  id             String    @id @default(cuid())
  organizationId String
  email          String // destino do convite
  role           String    @default("MEMBER") // MEMBER | ADMIN
  profile        String    @default("") // perfil pré-configurado RBAC
  permissions    String[]  @default([])
  tokenHash      String    @unique // SHA-256 hex do token plain
  invitedById    String? // OWNER/ADMIN que criou
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, acceptedAt])
  @@index([expiresAt])
}

// Tokens de confirmação de e-mail. Mesma estrutura do reset, mas com TTL
// maior (7 dias) porque o usuário pode demorar a abrir o e-mail.
model EmailVerifyToken {
  id        String    @id @default(cuid())
  userId    String
  email     String // e-mail sendo verificado (pode ser troca de e-mail)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// Trilha de auditoria: registra ações relevantes (criação/edição/bloqueio de
// usuários, etc.) por organização, para o "Histórico de atividades".
model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String? // quem executou a ação
  actorName      String   @default("")
  action         String // ex.: user.create | user.update | user.block | user.unblock | user.delete
  detail         String   @default("") // descrição legível da ação
  targetId       String? // id do alvo (ex.: usuário afetado)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model OrgModule {
  id             String  @id @default(cuid())
  organizationId String
  moduleId       String
  enabled        Boolean @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, moduleId])
  @@index([organizationId])
}

// Cobrança PIX gerada no PDV. No fluxo assíncrono, a venda (Sale) só é criada
// quando a cobrança é confirmada como `pago`. Idempotente por `token` (o mesmo
// token de venda do PDV) e por `txid`. provider="" = simulado (BR Code gerado
// localmente); "mercadopago" = cobrança real via PSP. e2eId é o end-to-end id
// do PIX (preenchido na confirmação). reconciledAt marca a conciliação.
model PixCharge {
  id             String    @id @default(cuid())
  organizationId String
  saleId         String?   @unique // ligado quando a venda é finalizada
  token          String    @unique // = token da venda no PDV (idempotência)
  txid           String    @unique
  amount         Decimal   @db.Decimal(12, 2)
  status         String    @default("pendente") // pendente | pago | expirado | cancelado
  brCode         String    @default("") // copia-e-cola (payload EMV); vazio quando vai pra maquininha
  qrImage        String    @default("") // QR como data URL / URL (opcional)
  provider       String    @default("") // "" simulado | "mercadopago"
  providerRef    String    @default("") // id da cobrança no PSP (ou da payment-intent, na maquininha)
  // Maquininha (Mercado Pago Point): cobrança exibida na tela do terminal.
  terminal       Boolean   @default(false)
  deviceId       String    @default("") // id do aparelho quando terminal=true
  e2eId          String    @default("") // end-to-end id do PIX (na confirmação)
  expiresAt      DateTime?
  paidAt         DateTime?
  reconciledAt   DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sale         Sale?        @relation(fields: [saleId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
}

// Configuração PIX da empresa (uma por org). O token do PSP fica em variável de
// ambiente no servidor (espelha o Focus NFe); aqui só os dados não-secretos.
model PixConfig {
  id             String   @id @default(cuid())
  organizationId String   @unique
  // "" = simulado (BR Code da chave) | "mercadopago" = cobrança real.
  provider       String   @default("")
  pixKey         String   @default("") // chave PIX do recebedor (BR Code simulado)
  beneficiario   String   @default("") // nome do recebedor (máx. 25 no EMV)
  cidade         String   @default("") // cidade do recebedor (máx. 15 no EMV)
  expiraSegundos Int      @default(3600)
  // Maquininha (Mercado Pago Point): id do aparelho pareado para exibir o QR.
  deviceId       String   @default("")
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Configuração WhatsApp Business da empresa (uma por org). O token Meta fica em
// variável de ambiente no servidor; aqui só os identificadores não-secretos.
model WhatsAppConfig {
  id             String   @id @default(cuid())
  organizationId String   @unique
  provider       String   @default("") // "" simulado | "meta"
  phoneNumberId  String   @default("") // Phone Number ID da Cloud API
  remetente      String   @default("") // número/nome exibido
  enabled        Boolean  @default(false)
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Log de mensagens WhatsApp enviadas (cobrança PIX, recibo, recompra CRM, manual).
model WhatsAppMessage {
  id             String    @id @default(cuid())
  organizationId String
  customerId     String?
  toPhone        String
  kind           String    @default("manual") // pix | recibo | crm | manual
  body           String    @default("")
  templateName   String    @default("")
  status         String    @default("enfileirado") // enfileirado | enviado | entregue | lido | falha
  provider       String    @default("") // "" simulado | "meta"
  providerRef    String    @default("") // id da mensagem no provedor (wamid)
  error          String    @default("")
  createdAt      DateTime  @default(now())
  sentAt         DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)
  user         User?        @relation(fields: [userId], references: [id])
  userId       String?

  @@index([organizationId, status])
  @@index([providerRef])
}

// ===========================================================================
// SUPRIMENTOS / COMPRAS — fluxo: Solicitação → Aprovação → Cotação → Pedido →
// Recebimento → (Estoque + Financeiro). Todas as tabelas são escopadas por
// organizationId (multi-tenant) e indexadas para as consultas do dashboard.
// ===========================================================================

// Solicitação de compra: um usuário pede materiais. Passa por aprovação e pode
// virar cotação. `number` é sequencial humano por organização (ex.: SC-000123).
model PurchaseRequisition {
  id             String   @id @default(cuid())
  organizationId String
  number         String
  requesterId    String? // usuário solicitante
  requesterName  String   @default("")
  costCenterId   String?
  status         String   @default("aberta") // aberta | em_aprovacao | aprovada | rejeitada | convertida
  priority       String   @default("media") // baixa | media | alta | urgente
  estimatedTotal Decimal  @default(0) @db.Decimal(12, 2)
  note           String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  costCenter   CostCenter?               @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  items        PurchaseRequisitionItem[]
  approvals    PurchaseApproval[]
  quotations   Quotation[]
  orders       PurchaseOrder[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

model PurchaseRequisitionItem {
  id                String  @id @default(cuid())
  requisitionId     String
  productId         String?
  name              String
  quantity          Int
  priority          String  @default("media") // baixa | media | alta | urgente
  justification     String  @default("")
  estimatedUnitCost Decimal @default(0) @db.Decimal(12, 2)

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId])
}

// Etapa de aprovação (workflow multinível). O nível exigido é decidido pelo
// valor estimado: <=5k Supervisor, <=20k Gerente, >20k Diretor. Cada decisão
// (aprovar/rejeitar/solicitar ajuste) vira um registro — histórico completo.
model PurchaseApproval {
  id            String   @id @default(cuid())
  requisitionId String
  level         String // supervisor | gerente | diretor
  status        String   @default("pendente") // pendente | aprovado | rejeitado | ajuste
  approverId    String?
  approverName  String   @default("")
  note          String   @default("")
  decidedAt     DateTime?
  createdAt     DateTime @default(now())

  requisition PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([requisitionId])
}

// Cotação: envia a demanda a vários fornecedores e compara as propostas.
model Quotation {
  id              String   @id @default(cuid())
  organizationId  String
  requisitionId   String?
  number          String
  status          String   @default("aberta") // aberta | respondida | fechada | cancelada
  deadline        DateTime?
  winnerSupplierId String? // fornecedor vencedor (ao fechar)
  note            String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requisition  PurchaseRequisition? @relation(fields: [requisitionId], references: [id], onDelete: SetNull)
  items        QuotationItem[]
  suppliers    QuotationSupplier[]
  orders       PurchaseOrder[]

  @@unique([organizationId, number])
  @@index([organizationId, status])
}

// Item demandado na cotação (o mesmo para todos os fornecedores convidados).
model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  productId   String?
  name        String
  quantity    Int

  quotation Quotation              @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  prices    QuotationSupplierItem[]

  @@index([quotationId])
}

// Proposta de um fornecedor para a cotação (cabeçalho: prazo, pagamento, total).
model QuotationSupplier {
  id           String   @id @default(cuid())
  quotationId  String
  supplierId   String
  paymentTerm  String   @default("")
  leadTimeDays Int      @default(0)
  total        Decimal  @default(0) @db.Decimal(12, 2)
  note         String   @default("")
  respondedAt  DateTime?
  createdAt    DateTime @default(now())

  quotation Quotation              @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  supplier  Supplier               @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  prices    QuotationSupplierItem[]

  @@unique([quotationId, supplierId])
  @@index([quotationId])
}

// Preço unitário de um fornecedor para um item da cotação (matriz comparativa).
model QuotationSupplierItem {
  id                  String  @id @default(cuid())
  quotationSupplierId String
  quotationItemId     String
  unitPrice           Decimal @default(0) @db.Decimal(12, 2)

  quotationSupplier QuotationSupplier @relation(fields: [quotationSupplierId], references: [id], onDelete: Cascade)
  item              QuotationItem     @relation(fields: [quotationItemId], references: [id], onDelete: Cascade)

  @@unique([quotationSupplierId, quotationItemId])
  @@index([quotationItemId])
}

// Recebimento de materiais de um pedido. Permite recebimento parcial e registra
// divergências de quantidade e qualidade por item.
model Receipt {
  id             String   @id @default(cuid())
  organizationId String
  orderId        String
  number         String
  status         String   @default("aprovado") // aprovado | parcial | rejeitado
  receivedById   String?
  receivedByName String   @default("")
  note           String   @default("")
  createdAt      DateTime @default(now())

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        PurchaseOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items        ReceiptItem[]

  @@index([organizationId])
  @@index([orderId])
}

model ReceiptItem {
  id          String  @id @default(cuid())
  receiptId   String
  orderItemId String?
  productId   String?
  name        String
  qtyOrdered  Int     @default(0)
  qtyReceived Int     @default(0)
  qualityOk   Boolean @default(true)
  note        String  @default("")

  receipt   Receipt            @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  orderItem PurchaseOrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([receiptId])
}

// Razão (ledger) de movimentação de estoque. TODA alteração de saldo passa por
// aqui — venda, recebimento, ajuste, importação — dando histórico auditável.
// quantity é com sinal (entrada positiva, saída negativa). balanceAfter é o
// saldo do produto após o movimento.
model StockMovement {
  id             String   @id @default(cuid())
  organizationId String
  productId      String
  type           String // entrada | saida | ajuste
  reason         String   @default("") // venda | recebimento | ajuste | devolucao_cliente | perda | ...
  quantity       Int // com sinal: +entrada / -saída
  balanceBefore  Int      @default(0) // saldo do produto ANTES do movimento (auditoria)
  balanceAfter   Int      @default(0) // saldo do produto DEPOIS do movimento
  refType        String   @default("") // sale | receipt | adjust | manual | import | initial
  refId          String   @default("")
  userId         String? // usuário responsável
  userName       String   @default("") // nome do responsável (snapshot p/ auditoria)
  note           String   @default("")
  // Local onde o movimento ocorreu (null só em registros anteriores ao
  // multi-local; o backfill aponta todos para a matriz).
  locationId     String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([productId])
  @@index([locationId])
}

// ===========================================================================
// MARKETING COM IA — carrosséis profissionais para Instagram.
// ===========================================================================

// Identidade visual da organização (cores, fontes, logo). Uma por org.
model BrandKit {
  id              String   @id @default(cuid())
  organizationId  String   @unique
  primaryColor    String   @default("#6366F1")
  darkColor       String   @default("#312E81")
  lightColor      String   @default("#A5B4FC")
  lightBg         String   @default("#F8F7FF")
  darkBg          String   @default("#0F0E17")
  fontHeading     String   @default("Plus Jakarta Sans")
  fontBody        String   @default("Plus Jakarta Sans")
  logoText        String   @default("")
  tagline         String   @default("")
  instagramHandle String   @default("")
  updatedAt       DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Campanha = um carrossel gerado pela IA. Cada campanha tem 7 slides.
model Campaign {
  id             String   @id @default(cuid())
  organizationId String
  prompt         String
  status         String   @default("draft") // draft | rendering | ready | error
  slideCount     Int      @default(7)
  errorMsg       String   @default("")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slides       CampaignSlide[]

  @@index([organizationId, createdAt])
}

// Slide individual de uma campanha (conteúdo + caminho da imagem renderizada).
model CampaignSlide {
  id         String   @id @default(cuid())
  campaignId String
  index      Int
  layout     String   @default("")
  headline   String   @default("")
  body       String   @default("")
  bullets    String[] @default([])
  imageUrl   String   @default("")
  createdAt  DateTime @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, index])
}

// Assinatura do módulo de Marketing (separada da assinatura SaaS principal).
model MarketingSubscription {
  id                 String    @id @default(cuid())
  organizationId     String    @unique
  plan               String    @default("trial") // trial | basico | pro | enterprise
  status             String    @default("active") // active | trial_ended | canceled
  credits            Int       @default(8)
  currentPeriodStart DateTime  @default(now())
  currentPeriodEnd   DateTime
  trialEndsAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledger       CreditLedger[]
}

// Razão de créditos (event sourcing): positivo = crédito, negativo = débito.
model CreditLedger {
  id             String    @id @default(cuid())
  organizationId String
  marketingSubId String?
  campaignId     String?
  amount         Int
  reason         String
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  marketingSub MarketingSubscription? @relation(fields: [marketingSubId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Conferência / inventário de estoque. Contagem física comparada ao sistema.
// NENHUM ajuste de estoque acontece durante a contagem — só após aprovação,
// via razão (StockMovement), preservando a auditoria.
// ---------------------------------------------------------------------------
model StockCount {
  id              String    @id @default(cuid())
  organizationId  String
  number          String // CONF-AAAA-NNNN (sequencial por org/ano)
  type            String    @default("geral") // geral | parcial | ciclica | localizacao
  location        String    @default("") // depósito/armazém/localização (texto)
  status          String    @default("rascunho") // rascunho | em_conferencia | aguardando_aprovacao | aprovada | ajustada | cancelada
  responsibleId   String?
  responsibleName String    @default("")
  note            String    @default("")
  // Conferência CEGA: o operador não vê o saldo do sistema nem a divergência
  // durante a contagem (padrão WMS anti-viés); tudo aparece na aprovação.
  blind           Boolean   @default(false)
  createdById     String?
  createdByName   String    @default("")
  approvedById    String?
  approvedByName  String    @default("")
  approvedAt      DateTime?
  adjustedAt      DateTime?
  finalizedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  locationId   String? // local conferido (null = local padrão)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  locationRef  Location?        @relation(fields: [locationId], references: [id], onDelete: SetNull)
  items        StockCountItem[]

  @@unique([organizationId, number])
  @@index([organizationId])
  @@index([organizationId, status])
}

model StockCountItem {
  id           String   @id @default(cuid())
  stockCountId String
  productId    String
  productName  String // snapshot p/ o histórico
  barcode      String   @default("")
  sku          String   @default("")
  category     String   @default("")
  systemQty    Int // saldo do sistema no momento da adição do item
  countedQty   Int? // null = ainda não contado
  unitCost     Decimal  @default(0) @db.Decimal(12, 2) // custo p/ valorizar a divergência
  note         String   @default("")
  createdAt    DateTime @default(now())

  count StockCount @relation(fields: [stockCountId], references: [id], onDelete: Cascade)

  @@unique([stockCountId, productId])
  @@index([stockCountId])
}
